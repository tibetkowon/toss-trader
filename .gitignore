# Go
/bin/
/dist/
*.exe
*.test
*.out

# Env / secrets - never commit credentials
.env
.env.*
*.pem
*.key
secrets.json

# Infra identifiers (GCP project ID, bucket slug, static IP, account IDs)
# - repo is public, so real deployment values must stay local-only
*.tfvars
*.tfstate
*.tfstate.*
.terraform/
config.local.*
config.local.yaml

# SQLite DB files (local/dev data, not source)
*.db
*.sqlite
*.sqlite3

# Runtime state / snapshots (contain real balance & trade data)
snapshots/
*.snapshot.json

# Logs
*.log

# OS / editor
.DS_Store
.idea/
.vscode/
